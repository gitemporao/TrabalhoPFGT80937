cabal-version:      2.4
name:               loja-online-stock
version:            0.1.0.0
synopsis:           Sistema de Loja Online e Gestao de Stock em Haskell
description:        Trabalho Pratico Semestral de Programacao Funcional (Fase 1).
author:             Grupo de Programacao Funcional
category:           Education
build-type:         Simple

library
    exposed-modules:  Model
                    , Domain
                    , DataFixtures
    hs-source-dirs:   src
    default-language: Haskell2010
    build-depends:    base >= 4.14 && < 5.0
    ghc-options:      -Wall

executable loja-online-stock
    main-is:          Main.hs
    hs-source-dirs:   app
    default-language: Haskell2010
    build-depends:    base >= 4.14 && < 5.0
                    , loja-online-stock
    ghc-options:      -Wall

test-suite loja-test
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    default-language: Haskell2010
    build-depends:    base >= 4.14 && < 5.0
                    , loja-online-stock
    ghc-options:      -Wall
